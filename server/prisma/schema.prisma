generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique @db.VarChar(30)
  email        String  @unique @db.VarChar(255)
  passwordHash String  @map("password_hash")
  displayName  String? @map("display_name") @db.VarChar(100)
  avatarKey    String? @map("avatar_key") @db.VarChar(100)
  bio          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings UserSettings?

  programs        Program[]        @relation("UserPrograms")
  routines        Routine[]        @relation("UserRoutines")
  workoutSessions WorkoutSession[]

  @@map("users")
}

model UserSettings {
  userId               String     @id @map("user_id") @db.Uuid
  weightUnit           WeightUnit @default(KG) @map("weight_unit")
  defaultRestSeconds   Int        @default(90) @map("default_rest_seconds")
  notificationsEnabled Boolean    @default(true) @map("notifications_enabled")
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum WeightUnit {
  KG
  LB
}

model Exercise {
  id               String   @id @db.VarChar(100)
  name             String   @db.VarChar(200)
  force            String?  @db.VarChar(50)
  level            String?  @db.VarChar(50)
  mechanic         String?  @db.VarChar(50)
  equipment        String?  @db.VarChar(100)
  primaryMuscles   String[] @map("primary_muscles")
  secondaryMuscles String[] @map("secondary_muscles")
  instructions     String[]
  category         String?  @db.VarChar(100)
  images           String[]

  routineExercises RoutineExercise[]
  sessionExercises SessionExercise[]

  @@index([name])
  @@map("exercises")
}

model Program {
  id              String  @id @default(uuid()) @db.Uuid
  ownerId         String? @map("owner_id") @db.Uuid
  name            String  @db.VarChar(150)
  description     String?
  imageKey        String? @map("image_key") @db.VarChar(100)
  sourceProgramId String? @map("source_program_id") @db.Uuid
  sortOrder       Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner         User?     @relation("UserPrograms", fields: [ownerId], references: [id], onDelete: Cascade)
  sourceProgram Program?  @relation("ProgramCopies", fields: [sourceProgramId], references: [id], onDelete: SetNull)
  copies        Program[] @relation("ProgramCopies")
  routines      Routine[]

  @@index([ownerId])
  @@map("programs")
}

model Routine {
  id          String  @id @default(uuid()) @db.Uuid
  ownerId     String? @map("owner_id") @db.Uuid
  programId   String? @map("program_id") @db.Uuid
  name        String  @db.VarChar(150)
  description String?
  imageKey    String? @map("image_key") @db.VarChar(100)
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner           User?             @relation("UserRoutines", fields: [ownerId], references: [id], onDelete: Cascade)
  program         Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  exercises       RoutineExercise[]
  workoutSessions WorkoutSession[]

  @@index([ownerId])
  @@index([programId])
  @@map("routines")
}

model RoutineExercise {
  id          String  @id @default(uuid()) @db.Uuid
  routineId   String  @map("routine_id") @db.Uuid
  exerciseId  String  @map("exercise_id") @db.VarChar(100)
  sortOrder   Int     @default(0) @map("sort_order")
  notes       String?
  restSeconds Int     @default(90) @map("rest_seconds")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  routine          Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise         Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets             RoutineSet[]
  sessionExercises SessionExercise[]

  @@index([routineId])
  @@index([exerciseId])
  @@map("routine_exercises")
}

model RoutineSet {
  id                String  @id @default(uuid()) @db.Uuid
  routineExerciseId String  @map("routine_exercise_id") @db.Uuid
  setOrder          Int     @map("set_order")
  setType           SetType @default(NORMAL) @map("set_type")
  targetWeightKg    Decimal @default(0) @map("target_weight_kg") @db.Decimal(8, 2)
  targetReps        Int     @default(0) @map("target_reps")

  routineExercise RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  sessionSets SessionSet[]

  @@unique([routineExerciseId, setOrder])
  @@map("routine_sets")
}

enum SetType {
  NORMAL
  WARMUP
  DROP
}

enum WorkoutStatus {
  IN_PROGRESS
  COMPLETED
  DISCARDED
}

model WorkoutSession {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  sourceRoutineId String?       @map("source_routine_id") @db.Uuid
  name            String        @db.VarChar(150)
  status          WorkoutStatus @default(IN_PROGRESS)

  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  durationSeconds  Int?      @map("duration_seconds")
  routineUpdatedAt DateTime? @map("routine_updated_at") @db.Timestamptz(6)
  notes            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRoutine Routine?          @relation(fields: [sourceRoutineId], references: [id], onDelete: SetNull)
  exercises     SessionExercise[]

  @@index([userId, status])
  @@index([userId, startedAt])
  @@index([sourceRoutineId])
  @@map("workout_sessions")
}

model SessionExercise {
  id                      String  @id @default(uuid()) @db.Uuid
  sessionId               String  @map("session_id") @db.Uuid
  exerciseId              String  @map("exercise_id") @db.VarChar(100)
  sourceRoutineExerciseId String? @map("source_routine_exercise_id") @db.Uuid

  sortOrder   Int     @default(0) @map("sort_order")
  notes       String?
  restSeconds Int     @default(90) @map("rest_seconds")

  session               WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise              Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sourceRoutineExercise RoutineExercise? @relation(fields: [sourceRoutineExerciseId], references: [id], onDelete: SetNull)
  sets                  SessionSet[]

  @@index([sessionId])
  @@index([exerciseId])
  @@map("session_exercises")
}

model SessionSet {
  id                 String  @id @default(uuid()) @db.Uuid
  sessionExerciseId  String  @map("session_exercise_id") @db.Uuid
  sourceRoutineSetId String? @map("source_routine_set_id") @db.Uuid

  setOrder Int     @map("set_order")
  setType  SetType @default(NORMAL) @map("set_type")

  weightKg Decimal @default(0) @map("weight_kg") @db.Decimal(8, 2)
  reps     Int     @default(0)

  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  sessionExercise  SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  sourceRoutineSet RoutineSet?     @relation(fields: [sourceRoutineSetId], references: [id], onDelete: SetNull)

  @@unique([sessionExerciseId, setOrder])
  @@index([sourceRoutineSetId])
  @@map("session_sets")
}
